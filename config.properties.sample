# Google Custom Search API настройки
API_KEY=yourGoogleCustomSearchApiKey
CX=yourGoogleCustomSearchCx

# Anki deck settings
# DECK_ID is optional: when omitted, a stable ID is derived from the CSV file
# name, so different CSVs never merge into one deck on import.
#DECK_ID=999004
DECK_NAME=Custom EN-RU Vocabulary Deck
